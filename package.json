{
  "name": "barangay-services",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/index.js --local-dev",
    "build": "next build frontend --webpack",
    "start": "node --env-file-if-exists=.env backend/index.js --production",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.js",
    "db:bootstrap": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/bootstrap.js",
    "test": "node --test",
    "test:integration": "node scripts/verify-integration.js"
  },
  "dependencies": {
    "better-auth": "^1.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "next": "^16.0.0",
    "nodemailer": "^8.0.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  }
}
